includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 7
    paths:
        - src
        - tests
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        -
            message: '#Call to function method_exists\(\) with .*Decimal.*valueOf.*will always evaluate to false\.#'
            path: src/functions.php
